print "NOVA Complex Example: Grade Calculator"

ask "Enter your score:" and store as score

create variable bonus = 5
create variable final_score = score + bonus

print "Final score:"
print final_score

if final_score is greater than or equal to 90:
    print "Grade: A"

if final_score is greater than or equal to 80:
    if final_score is less than 90:
        print "Grade: B"

if final_score is greater than or equal to 70:
    if final_score is less than 80:
        print "Grade: C"

if final_score is greater than or equal to 60:
    if final_score is less than 70:
        print "Grade: D"

if final_score is less than 60:
    print "Grade: F"

print "Done"